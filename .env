# === API Keys ===
# Get your key at https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=
# Backward compatibility: if WAVESPEED_API_KEY is empty, backend will fallback to FAL_KEY.
FAL_KEY=

# === Database ===
POSTGRES_USER=gigachat
POSTGRES_PASSWORD=gigachat
POSTGRES_DB=gigachat_video

# DATABASE_URL is constructed automatically in docker-compose
# For local dev outside Docker:
# DATABASE_URL=postgresql://gigachat:gigachat@localhost:5432/gigachat_video

# === Redis ===
# REDIS_URL is set automatically in docker-compose
# For local dev:
# REDIS_URL=redis://localhost:6379/0

# === Frontend ===
NEXT_PUBLIC_API_URL=http://192.168.0.104/api

# === Backend ===
# Public base URL used to build image URLs returned to clients
BASE_URL=http://localhost
# Optional WaveSpeed tuning
WAVESPEED_MODEL_ID=wavespeed-ai/wan-2.2-spicy/image-to-video
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_POLL_TIMEOUT_SEC=180
WAVESPEED_POLL_INTERVAL_SEC=2
WAVESPEED_RESOLUTION_LOW=480p
WAVESPEED_RESOLUTION_HIGH=720p
WAVESPEED_IMAGE_FIELD=image
