# === API Keys ===
# Get your key at https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# === Database ===
POSTGRES_USER=gigachat
POSTGRES_PASSWORD=gigachat
POSTGRES_DB=gigachat_video

# If set, overrides compose-generated DATABASE_URL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === Redis ===
# If set, overrides compose-generated REDIS_URL:
# REDIS_URL=redis://redis:6379/0

# === Frontend ===
# Use relative URL to work on VM/IP/domain behind nginx
NEXT_PUBLIC_API_URL=/api
# Used by Next.js server to proxy /api when you open frontend directly on :3000
NEXT_INTERNAL_API_URL=http://backend:8000/api

# === Backend ===
# Public base URL used to build image URLs returned to clients
# If empty, backend will auto-detect from incoming request host
BASE_URL=

# Uploads / storage
UPLOAD_DIR=/uploads
STATIC_UPLOADS_URL_PREFIX=/static/uploads
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp
MAX_UPLOAD_MB=20
# Optional WaveSpeed tuning
WAVESPEED_MODEL_ID=wavespeed-ai/wan-2.2-spicy/image-to-video
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_POLL_TIMEOUT_SEC=180
WAVESPEED_POLL_INTERVAL_SEC=2
WAVESPEED_RESOLUTION_LOW=480p
WAVESPEED_RESOLUTION_HIGH=720p
WAVESPEED_IMAGE_FIELD=image
